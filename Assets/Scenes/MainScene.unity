  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC774\uBC88 \uC0C1\uB300\uB294 \uBD81\uBD80 \uBCC0\uACBD\uC5D0\uC11C
    \uBA85\uC131\uC744 \uB5A8\uCE5C \u2018\uC7BF\uBD88 \uAC80\uD22C\uC0AC\uB2E8\u2019\uC774\uB2E4.
    \uC0B4\uC544\uB0A8\uAE30 \uC704\uD574 \uC2F8\uC6CC\uC628 \uC790\uB4E4\uB2F5\uAC8C
    \uBAA8\uB4E0 \uB2E8\uC6D0\uC774 \uC2E4\uC804\uC5D0 \uC775\uC219\uD558\uBA70,
    \uC804\uC5F4\uC744 \uBB34\uB108\uB728\uB9AC\uB294 \uB3CC\uACA9 \uC804\uC220\uC744
    \uC990\uACA8 \uC0AC\uC6A9\uD55C\uB2E4. \uD2B9\uD788 \uC120\uBD09\uC5D0 \uC11C\uB294
    \uAC70\uD55C \uBE0C\uB85C\uD06C\uB294 \uAC70\uB300\uD55C \uB3C4\uB07C \uD55C
    \uC790\uB8E8\uB85C \uBC29\uD328\uBCD1\uAE4C\uC9C0 \uBC00\uC5B4\uBC84\uB9B4 \uC815\uB3C4\uC758
    \uAD34\uB825\uC744 \uC9C0\uB154\uB2E4. \uD6C4\uBC29\uC758 \uCC3D\uD22C\uC0AC\uB4E4\uC740
    \uBE48\uD2C8\uC744 \uC9D1\uC694\uD558\uAC8C \uB178\uB9AC\uB2C8, \uC804\uC5F4
    \uC720\uC9C0\uC5D0 \uC2E4\uD328\uD558\uBA74 \uC21C\uC2DD\uAC04\uC5D0 \uD3EC\uC704\uB2F9\uD560
    \uC218 \uC788\uB2E4. \uC7A5\uAE30\uC804\uC73C\uB85C \uB04C\uACE0 \uAC00\uAE30\uBCF4\uB2E4\uB294
    \uCD08\uBC18\uC5D0 \uC9C0\uD718\uBCD1\uC744 \uB178\uB824 \uD750\uB984\uC744 \uB04A\uB294
    \uD3B8\uC774 \uC720\uB9AC\uD558\uB2E4. "
